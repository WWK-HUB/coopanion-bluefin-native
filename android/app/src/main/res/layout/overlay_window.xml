<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <WebView
        android:id="@+id/overlay_web"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:isScrollContainer="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/overlay_chrome"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_overlay_handle"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/overlay_handle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/overlay_drag_handle"
            android:paddingHorizontal="12dp"
            android:scaleType="center"
            android:src="@drawable/ic_drag_handle" />

        <ImageView
            android:id="@+id/overlay_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/overlay_close"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</FrameLayout>
